# Root .env.example — copy to .env and fill in values

# Backend
SECRET_KEY=change-this-to-a-random-32-char-string
DEBUG=false

# Cloudinary (optional — free tier)
# Sign up at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PostHog analytics (optional — free tier)
# Sign up at https://posthog.com/
VITE_POSTHOG_KEY=
